PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/tradexgg
JWT_SECRET=troque-por-um-segredo-forte-minimo-32-chars
JWT_EXPIRES_IN=7d
NODE_ENV=development
SITE_URL=http://localhost:3000

# Email (Brevo — brevo.com, 300 emails/dia gratis)
BREVO_API_KEY=sua-api-key-brevo
BREVO_SENDER_EMAIL=seu-email@dominio.com
EMAIL_FROM_NAME=tradexGG

# Docker / PostgreSQL (usado pelo docker-compose.yml)
# Se não definido, docker-compose usa os valores padrão (tradex/tradexpass/tradexgg)
POSTGRES_USER=tradex
POSTGRES_PASSWORD=troque-por-senha-forte
POSTGRES_DB=tradexgg
